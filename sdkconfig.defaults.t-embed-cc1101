# LilyGO T-Embed CC1101 overlay. Applied after sdkconfig.defaults when
# building with -DBOARD=t-embed-cc1101.
CONFIG_BOARD_T_EMBED_CC1101=y
# CONFIG_BOARD_GENERIC_S3 is not set
# CONFIG_DISPLAY_SSD1306 is not set
CONFIG_DISPLAY_ST7789=y
CONFIG_STATUS_LED=y
CONFIG_STATUS_LED_GPIO=14
CONFIG_STATUS_LED_COUNT=8
# CONFIG_STATUS_LED_DRIVE_DEVKIT_ALT is not set
CONFIG_SD_SPI_MISO_GPIO=10
CONFIG_SD_SPI_MOSI_GPIO=9
CONFIG_SD_SPI_SCK_GPIO=11
CONFIG_SD_SPI_CS_GPIO=13
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
