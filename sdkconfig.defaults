# Vibe Pocket File Server - ESP32-S3 default config
CONFIG_BOARD_GENERIC_S3=y
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_STATUS_LED=y
CONFIG_STATUS_LED_GPIO=48
CONFIG_STATUS_LED_COUNT=1
CONFIG_STATUS_LED_DRIVE_DEVKIT_ALT=y
CONFIG_STATUS_LED_BRIGHTNESS=8
CONFIG_DISPLAY_SSD1306=y
CONFIG_DISPLAY_SSD1306_SDA_GPIO=18
CONFIG_DISPLAY_SSD1306_SCL_GPIO=17
CONFIG_DISPLAY_SSD1306_128X32=y
# CONFIG_DISPLAY_SSD1306_128X64 is not set
CONFIG_SD_SPI_MISO_GPIO=12
CONFIG_SD_SPI_MOSI_GPIO=11
CONFIG_SD_SPI_SCK_GPIO=13
CONFIG_SD_SPI_CS_GPIO=5
